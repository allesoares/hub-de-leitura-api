{
  "info": {
    "_postman_id": "f9ae9b1c-d97c-4a61-87cb-b29770bb0633",
    "name": "Hub de Leitura - Catálogo de Livros",
    "description": "Exercício de Catálogo de Livros: sete operações, negativos de cadastro (400), alteração (404) e exclusão com reserva (400). Execute as 18 requisições em ordem.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
